{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2BackupPermissions",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:DescribeImages",
                "ec2:CreateImage",
                "ec2:DeregisterImage",
                "ec2:DeleteSnapshot",
                "ec2:CreateTags"
            ],
            "Resource": "*"
        }
    ]
}